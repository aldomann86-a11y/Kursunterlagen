# Lokale Entwicklung: Datei nach .env kopieren und ausfüllen.
# Echte Werte gehören nach ~/.claude/secrets.local.md, nie ins Repo (public!).

# Signiert die Sitzungs-Cookies (Admin und Teilnehmer). Lokal darf er fehlen,
# dann wird je Prozess ein zufälliger erzeugt. In Produktion Pflicht.
SECRET_KEY=

# Erstes Admin-Passwort. Nur beim ersten Start gesetzt, danach leeren.
ADMIN_INITIAL_PASSWORD=

# Zweiter Faktor für das Admin-Login (TOTP). 1 = Pflicht, 0 = aus.
ADMIN_2FA=0

# Datenbank und Uploads. Lokal ./data, im Container /data.
DATA_DIR=./data

# Cookies nur über HTTPS senden. Lokal 0, in Produktion 1.
HTTPS_ONLY=0

# Obergrenze je Datei in Megabyte.
MAX_UPLOAD_MB=50

# Versuche je Stunde und IP, einen Zugangscode zu erraten.
LIMIT_CODE_STUNDE=20
